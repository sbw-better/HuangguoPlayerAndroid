<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D12"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/topArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="短剧播放器"
            android:textColor="#F8FAFC"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="发现好故事，随时续看"
            android:textColor="#8E98AA"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/tabRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tab_rail"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="首页"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tabSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="搜索"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tabFav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="收藏"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tabRecent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="最近"
                android:textAllCaps="false" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/categoryScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/searchArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="输入短剧名称"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#F4F6F8"
                    android:textColorHint="#737D8C" />

                <Button
                    android:id="@+id/searchButton"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button"
                    android:text="搜索"
                    android:textColor="#111111"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:id="@+id/historyScroll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/historyRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/clearHistoryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:text="清空"
                    android:textAllCaps="false"
                    android:textColor="#9AA4B2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="20dp"
        android:textColor="#8E98AA"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <GridLayout
                android:id="@+id/contentGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingTop="4dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/loadMoreButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_dark_button"
                android:text="加载更多"
                android:textAllCaps="false"
                android:textColor="#F4F6F8"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/playerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#000000"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nowPlaying"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F4F6F8"
                android:textStyle="bold" />

            <Button
                android:id="@+id/closePlayerButton"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_dark_button"
                android:contentDescription="关闭播放"
                android:text="×"
                android:textAllCaps="false"
                android:textColor="#E8ECF3"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerActions1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prevButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_button"
                android:text="上一集"
                android:textColor="#E8ECF3"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/episodeButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_button"
                android:text="选集"
                android:textColor="#E8ECF3"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_button"
                android:text="下一集"
                android:textColor="#E8ECF3"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerActions2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retryButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_button"
                android:text="重试"
                android:textColor="#E8ECF3"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/speedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_button"
                android:text="1.0x"
                android:textColor="#E8ECF3"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/pipButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_button"
                android:text="画中画"
                android:textColor="#E8ECF3"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/fullscreenButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_button"
                android:text="全屏"
                android:textColor="#E8ECF3"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
